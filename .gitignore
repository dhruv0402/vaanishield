# Data — exclude bulky raw audio and augmented collections, keep manifests and consent audit
data/raw/*.wav
!data/raw/spk_1119_1119_020.wav
!data/raw/.gitkeep
!data/raw/raw_manifest.jsonl
data/processed/*.wav
data/processed/augmented/
data/processed/train_clones/
data/processed/heldout/
!data/processed/.gitkeep
!data/processed/master_manifest.jsonl
!data/processed/codeswitch_scripts.*

# Signed consent forms (local signed forms for private recordings, never committed)
data/consent_forms/signed/

# Python & environments
__pycache__/
*.pyc
.venv/
*.egg-info/

# Large checkpoints / models / zip archives
*.pt
*.ckpt
*.onnx
*.pkl
checkpoints/
*.zip

# Frontend build & temporary cache
.vite/
node_modules/
dist/

# Notebooks checkpoints
.ipynb_checkpoints/

# Env / secrets
.env

# OS
.DS_Store
